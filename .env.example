# Supabase Configuration
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_PUBLIC_AGENCY_SLUG=dream-supreme-properties

# Document storage bucket name (Supabase Storage). Direct client-side Cloudflare R2
# access has been removed — Vite inlines every VITE_-prefixed value into the shipped
# browser bundle, so an R2 IAM secret key can never be safely stored under a VITE_
# variable. Re-adding R2 support requires proxying uploads through a server-side
# function that holds the credentials outside the client bundle.
VITE_R2_BUCKET_NAME=dream-supreme-documents

# Restricts the admin portal UI to this hostname/origin (see src/lib/auth-routing.ts).
VITE_ADMIN_DOMAIN=admin.yourdomain.com

# Integration status flags shown on Admin > Settings. These are only ever checked for
# truthy presence to render a "Connected / Not configured" badge — never read as real
# credentials. Do not put a real API token/secret in a VITE_-prefixed variable; if any
# of these integrations start making authenticated calls, move that call server-side
# first (same reasoning as the R2 credential above).
VITE_WHATSAPP_API_TOKEN=configured
VITE_WHATSAPP_PHONE_NUMBER_ID=configured
VITE_CONVEYANCER_WEBHOOK_URL=https://your-webhook-endpoint.example.com
VITE_XERO_CLIENT_ID=configured
VITE_SAGE_API_KEY=configured
