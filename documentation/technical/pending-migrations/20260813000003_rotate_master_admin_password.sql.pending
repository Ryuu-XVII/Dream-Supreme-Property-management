-- Migration: Invalidate the hardcoded master admin password
-- Description: Migration 20260807000000_seed_master_admin.sql set the master admin account's
-- password to a plaintext value ('Admin@Dream2026!') that is committed to the repository, so
-- anyone with read access to the codebase or its git history knows a working admin credential.
-- This migration rotates that account's password hash to a random value that is never stored,
-- logged, or returned anywhere, immediately invalidating the known password. Nobody -- including
-- whoever runs this migration -- learns the new password; the account owner must use Supabase's
-- "forgot password" / recovery-email flow to set a new one before signing in again.

DO $$
DECLARE
  v_email text := 'admin@dreamsupreme.co.za';
BEGIN
  UPDATE auth.users
  SET encrypted_password = extensions.crypt(
        encode(extensions.gen_random_bytes(32), 'hex'),
        extensions.gen_salt('bf')
      ),
      updated_at = now()
  WHERE email = v_email;
END $$;
