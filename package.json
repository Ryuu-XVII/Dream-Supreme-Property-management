{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "packageManager": "npm@11.14.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run check:bundle",
    "check:drift": "node scripts/check-schema-drift.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "prepare": "husky",
    "r2:create": "wrangler r2 bucket create dream-supreme-documents",
    "r2:list": "wrangler r2 bucket list",
    "r2:lifecycle": "wrangler r2 bucket lifecycle add dream-supreme-documents auto-cleanup --expire-days 90 --abort-multipart-days 1 -y"
